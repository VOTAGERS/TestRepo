<link rel="stylesheet" href="/mazer/assets/vendors/simple-datatables/style.css">
<div class="page-heading">
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>
                    <%= title %>
                </h3>
                <p class="text-subtitle text-muted">Manage system users and their verification status.</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/workspace">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Users</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="card">
            <div class="card-header">
                User Status Data
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped text-center" id="userTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Github</th>
                                <th>Stack</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((u, i)=> { %>
                                <tr>
                                    <td>
                                        <%= u.PersonalName %>
                                    </td>
                                    <td>
                                        <%= u.Email %>
                                    </td>
                                    <td>
                                        <a href="<%= u.ProfileUrl %>" target="_blank" rel="noopener noreferrer">
                                            <%= u.ProfileUrl %>
                                        </a>
                                    </td>
                                    <td>
                                        <%= u.Stack %>
                                    </td>
                                    <td>
                                        <% if (u.Approval==='Y' ) { %><span class="badge bg-success">Verified</span>
                                            <% } else if (u.Approval==='N' ) { %>
                                                <span class="badge bg-warning">Unverified</span>
                                                <% } else { %><span class="badge bg-secondary">Unknown</span>
                                                    <% } %>
                                    </td>
                                    <td class="d-flex justify-content-center gap-1">
                                        <button type="button" onclick="showUserDetail('<%= u.GithubUserName %>')"
                                            class="btn btn-info">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Modal untuk menampilkan detail user -->
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-labelledby="userDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userDetailModalLabel">User Detail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="userDetailContent">
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/mazer/assets/vendors/simple-datatables/simple-datatables.js"></script>
<script>
    // Inisialisasi DataTables
    const dataTable = new simpleDatatables.DataTable(document.getElementById("userTable"), {
        perPage: 10,
        perPageSelect: [5, 10, 15, 20, 25]
    });

    function showUserDetail(username) {
        fetch(`/api/users/${username}/detail`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const user = data.data;
                    const detailContent = `
                        <div class="row">
                            <div class="col-md-4 ">
                                <img src="${user.avatar_url || '/assets/img/default-avatar.png'}"
                                     class="img-fluid rounded-circle mb-3"
                                     style="width: 150px; height: 150px; object-fit: cover;"
                                     alt="${user.username}">
                                <h5>${user.name || user.username}</h5>
                                <p class="text-muted">@${user.username}</p>
                                <a href="${user.profile_url}" target="_blank" class="btn btn-primary">
                                    <i class="bi bi-github"></i> View Profile
                                </a>
                            </div>
                            <div class="col-md-8">
                                <h6>Information</h6>
                                <table class="table table-borderless">
                                    <tr><td><strong>Email:</strong></td><td>${user.email || 'Not provided'}</td></tr>
                                    <tr><td><strong>Name:</strong></td><td>${user.name || 'Not provided'}</td></tr>
                                    <tr><td><strong>GitHub URL:</strong></td><td><a href="${user.profile_url}" target="_blank">${user.profile_url}</a></td></tr>
                                </table>
                            </div>
                        </div>
                    `;
                    document.getElementById('userDetailContent').innerHTML = detailContent;
                    new bootstrap.Modal(document.getElementById('userDetailModal')).show();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error fetching user detail:', error);
                alert('Error fetching user detail');
            });
    }
</script>