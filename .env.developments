# SETUP ENV GLOBAL APP\
PORT=8570 # Port runtime
FIREBASE_SERVICE_ACCOUNT_JSON= # Firebase Service Account JSON

# INI BUAT SKENARIO TES JIKA INGIN TES LOGIN
AUTH_CLIENT_ID= # Github OAuth Apps
AUTH_CLIENT_SECRET= # Github OAuth Apps
ACC_TOKEN= # Github Account generate classic token
AUTH_CLIENT_URL=http://localhost:8570/auth/github/callback # Callback using local port runtime

# INI UNTUK ACTION APPROVAL
ORGS_NAME=VOTAGERS # DIBIARKAN SAJA UNTUK SAAT INI

# INI UNTUK EMAIL SERVICE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=   # Your Email Account has been create security keys
# SMTP_PASS=   # Password in security apps


